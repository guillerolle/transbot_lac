
@article{cw_de_silva_design_2013,
	title = {A design paradigm for mechatronic systems},
	volume = {23},
	issn = {09574158},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0957415812001080},
	doi = {10.1016/j.mechatronics.2012.08.004},
	abstract = {Concepts of mechatronics are applicable in the design of complex and multi-domain dynamic systems. This paper presents an approach based on the mechatronic design quotient (MDQ) for systematic design of a mechatronic system. Traditional procedures of design are hierarchically separated into topological design and parametric design. Extending this concept, an MDQ may be ‘‘structured’’ into a multi-layered hierarchy. The approach and signiﬁcance of the application of MDQ in mechatronic design are indicated using illustrative examples.},
	language = {en},
	number = {8},
	urldate = {2023-02-22},
	journal = {Mechatronics},
	author = {{C.W. de Silva} and Behbahani, S.},
	month = dec,
	year = {2013},
	pages = {960--966},
	annote = {Anotaciones(10/5/2023 16:17:53)
"Layered optimization may not yield overall optimization" (C.W. de Silva y Behbahani, 2013, p. 4)
},
	annote = {Resumen
Presenta un método de diseño mecatrónico sistemático basado en un índice MDQ (Mechatronic Design Quotient).
En un diseño desacoplado, cada subsistema se diseña separadamente del resto considerando las interacciones con los otros subsistemas como constantes. El diseño mecatrónico involucra un diseño “acoplado” entre subsistemas.
Ejemplo: Motor eléctrico: Parte eléctrica y parte mecánica

De forma desacoplada, los subsistemas tienen un índice de diseño óptimo dado por \$i\_\{ue\}\$ para “uncoupled, electrical” y \$i\_\{um\}\$ para “uncoupled, mechanical”. Al juntarse los subsistemas en un sistema mayor, se define el MDQ como:
\$MDQ = \{x\_e i\_e{\textasciicircum}2 + x\_m i\_m{\textasciicircum}2 {\textbackslash}over \{x\_e i\_\{ue\}{\textasciicircum}2 + x\_m i\_\{um\}{\textasciicircum}2\}\}\$ donde \$x\_i\$ son pesos para cada subsistema o atributos de diseño. 
En el ejemplo hace:
\$MDQ = {\textbackslash}sum{\textbackslash}limits\_\{i=1\}{\textasciicircum}\{n\}W\_iI\_\{ij\}\$ con \$j = 1,2, …, m\$ y \$0 {\textless} M\_j {\textless} 1\$ con \$m\$ el numero total de soluciones, \$W\_i\$ es el peso del atributo de diseño \$i\$ y \$I\_\{ij\}\$ es el coeficiente de diseño para ese ese atributo, respecto a algún valor ideal del atributo.
Ejemplo: Sistema de posicionamiento para una máquina cortadora de pescado de 2 ejes

Recalca que la clave del MDQ está un enfoque jerárquico para la función objetivo. Por ejemplo, una MDQ puede ser optimizada para una capa de diseño en la que se evalúan dos o más grupos tecnológicos en esa capa. Luego, las subcapas asociadas a cada grupo tecnológico son optimizadas con otra función MDQ separadamente de los otros grupos tecnológicos. En la capa subsiguiente, se seleccionarían componentes específicos y/o parámetros.
“Speciﬁcally, an upper layer may optimize the actuator type for the particular application (e.g., hydraulic, dc, induction, stepper) with an appropriate MDQ. The next lower level may optimize the motor selection (e.g., a select a motor from an available set of dc motors—see Example given in the previous section) with another MDQ. DC motors available in the market, and matching drive systems, may be included in this level. In particular, linear graph models will facilitate component-based (and model-based) design and optimization. In this manner, a complex design optimization may be achieved through several design optimizations at different design levels. The ﬁnal design may not be precisely optimal, yet intuitively adequate for practical purposes; say in a conceptual design.” La optimización por capas propuesta no asegura una optimización global del problema de diseño.
Para el caso en particular de la cortadora de pescados, usa una función MDQ de “Choquet fuzzy integral” (Marichal, 2000) porque no se puede hacer por medio de una suma ponderada porque la interacción entre criterios afecta la decisión y la inferencia de un experto humano.
},
	file = {de Silva y Behbahani - 2013 - A design paradigm for mechatronic systems.pdf:/home/grolle/Zotero/storage/V8EPKMKY/de Silva y Behbahani - 2013 - A design paradigm for mechatronic systems.pdf:application/pdf},
}

@article{moulianitis_new_2018,
	title = {A new index based on mechatronics abilities for the conceptual design evaluation},
	volume = {49},
	issn = {09574158},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0957415817301745},
	doi = {10.1016/j.mechatronics.2017.11.011},
	abstract = {In this paper, a new mechatronics index is proposed for the evaluation of the alternatives in the conceptual design phase. The criteria aggregated to the index are acquired mostly by the collective knowledge presented in the Multi Annual Roadmap for robotics in Europe and adapted by considering the recent advancements in mechatronics. The mathematical formulation of this design index is based on the discrete Choquet integral, taking into account the interactions among the criteria. An application of the proposed mechatronics index to the design of an educational ﬁreﬁghting robot is presented as a case study to demonstrate the support to the designers in the conceptual design evaluation process.},
	language = {en},
	urldate = {2023-02-22},
	journal = {Mechatronics},
	author = {Moulianitis, V.C. and Zachiotis, G.-A.D. and Aspragathos, N.A.},
	month = feb,
	year = {2018},
	pages = {67--76},
	annote = {Resumen
Presenta un índice basado en competencias mecatrónicas para la optimización del proceso de diseño MDQ (C.W. de Silva y Behbahani, 2013). Las competencias mecatrónicas analizadas están inspiradas en (H2020\_Robotics\_Multi-Annual\_Roadmap\_ICT-2017B.pdf)
Las competencias que analiza son


Adaptabilidad


Habilidad cognitiva


Configurabilidad


Autonomía de Decisión


Dependabilidad


Habilidad de interacción


Habilidad de manipulación


Habilidad de movimiento


Habilidad de percepción


Las habilidades cualitativas están discriminadas en niveles donde el puntaje asociado a cada nivel es lineal

Función de agregación:
Usa integral de Choquet como método evaluación, considerando también criterios de interacción entre niveles. También usa o propone t-norms y operadores ponderantes para representar criterios independientes (Grabisch, 1996)
Interacción entre criterios:
La primer opción es que algunos niveles de un criterio en particular depende de satisfacer ciertos niveles de otro(s) criterio(s) como prerequisitos.

Integral de Choquet:
Permite agregar peso a la función de agregación no sólo por la importancia de cada criterio, sino también por subconjuntos de criterios.
El factor de peso de un subconjunto de criterios está representado por \${\textbackslash}mu\$, donde \$X = {\textbackslash}\{ x\_1, {\textbackslash}dots , x\_n{\textbackslash}\}\$ es el conjunto finito de criterios de evaluacion. \$A\$ es subconjunto de criterios del subconjunto \$B\$ de criterios que a su vez es subconjunto de \$X\$.

Este paper toma en cuenta restricciones entre pares de criterios solamente (Grabisch, 1997), habiendo un total de \$2{\textasciicircum}n\$ coeficientes a definir, donde \$n\$ es la cantidad total de criterios.
En (Grabisch, 1997) define la medida \${\textbackslash}mu(T)\$ de un subconjunto \$T {\textbackslash}subset X\$  como: o sea, con notación Moulianitis: \${\textbackslash}mu(T) = {\textbackslash}sum{\textbackslash}limits\_\{{\textbackslash}\{i,j{\textbackslash}\} {\textbackslash}subset T\} {\textbackslash}mu(x\_i,x\_j) - ( {\textbar}T{\textbar} - 2 ) {\textbackslash}sum{\textbackslash}limits\_\{i {\textbackslash}in T\} {\textbackslash}mu(x\_i)\$


Los coeficientes \$a\_i={\textbackslash}mu\_i\$ son los pesos individuales de cada criterio


Los coeficientes \${\textbackslash}mu\_\{ij\}\$ son los coeficientes de peso total para cada interacción entre criterios \$i,j\$


Los coeficientes \$a\_\{ij\}={\textbackslash}mu\_\{ij\}-{\textbackslash}mu\_i-{\textbackslash}mu\_j\$ son las contribuciones marginales de cada interacción (entre pares de criterios)


Las 4 interacciones consideradas en el paper son:

Las interacciones entre pares de criterios no definidas explícitamente, responden a la siguiente regla:
\${\textbackslash}mu(x\_i, x\_j) = {\textbackslash}mu(x\_i) + {\textbackslash}mu(x\_j)\$
Los efectos “Veto” y “Pass” actúan sobre conjuntos completos siempre que se cumple la condición. Ver ejemplo abajo para entender cómo funciona con el enfoque de contribución marginal
Casi textual (p.72 (6) col. 2):  
“Dado el conjunto de criterios \$X\$ y la medida “fuzzy” \${\textbackslash}mu\$, la integral de Choquet de una función \$f: X {\textbackslash}rightarrow [0, 1]\$ con respecto a \${\textbackslash}mu\$ se define como  
donde \$(.)\_\{(i)\}\$ indica que los indices se permutaron de forma que \$0{\textbackslash}leq f(x\_1){\textbackslash}leq{\textbackslash}dots{\textbackslash}leq f(x\_n) {\textbackslash}leq 1\$  y \$A\_\{(i)\}: ={\textbackslash}\{x\_i,{\textbackslash}dots,x\_n{\textbackslash}\}\$“
En este contexto, \$f(x\_i)\$ representa el puntaje de la alternativativa sobre cada criterio individual. La permutación \$(.)\_\{(i)\}\$  significa que los criterios están ordenados de menor a mayor puntaje. Agregar ejemplo con gráficas para que quede claro.
Ejemplo
Muestra un ejemplo de un robotito extinguidor diseñado y construido para competencias estudiantiles.
La información de diseño es presentada en términos de flujos de Energía, Materia e Información:

Funciones de diseño:



Las subfunciones con múltiples soluciones posibles son (el resto de las subfunciones tienen una sóla solución posible):

Descartando diseños inaceptablemente complicados, caros y/o desconocidos, hay 4 conjuntos de alternativas posibles:

Para la función de evaluación de cada alternativa se proponen 7 competencias mecatrónicas (detalladas en la sección 3 del paper) y también agrega un criterio de


trabajo/costo: es la suma de los recursos utilizados en la construcción del robot móvil (etimación del número y tipo de componentes que se deben fabricar/comprar, horas hombres utilizadas para el ensamblaje, escritura del código de control y/o ajustes de parámetros y ensayos, etc). Depende en la familiaridad del equipo de diseño con las tecnológias específicas del robot en consideración.


complejidad



Calculo de la integral de Choquet
Para el cálculo de la integral, se definen los pesos propios de cada criterio aislado. A cada uno, se le asignó un valor de “Alta importancia = 0.16” o “Baja importancia = 0.05” para simplificación (Notar que la suma de todos los pesos propios vale 1, no sé si es necesario que se cumpla esto).

Recalca que es importante definir la relación entre “alta y baja importancia” de forma acorde. Si la baja importancia fuera 0.01 y la alta 0.16, sería imposible definir la correlación positiva en la interacción entre criterios de alta y baja importancia, debido a las restricciones (1), porque \${\textbackslash}mu(x\_1) + {\textbackslash}mu(x\_2) {\textgreater} {\textbackslash}mu(x\_1, x\_2)\$ y \${\textbackslash}mu(x\_1, x\_2) {\textgreater} {\textbackslash}mu(x\_2)\$, con \${\textbackslash}mu(x\_1) = 0.01\$ y \${\textbackslash}mu(x\_2) = 0.16\$
Restricciones de interacción de criterios:


En el contexto de la competencia de robots extinguidores, los robots tienen que moverse autónomamente, por lo que “Decisional Autonomy (Autonomía de Decisión)” es muy importante y se considera que tiene “Veto Effect”: Si la solución tiene un mal valor en “Decisional Autonomy”, el puntaje global de la solución será malo


Favorecimiento de soluciones con baja complejidad y bajo costo: “Complexity” y “Labor/Cost” tienen correlación negativa


Más configurabilidad suele hacer que los sistemas se vuelvan más complejos. La configurabilidad permite más flexibilidad del perfil de funcionamiento que, a su vez, simplifica más que complejiza al robot. Esta situación se tiene en cuenta y se agrega restricción para que no favorezca diseños con buena performances en las 2 categorías (correlación positiva)


Motion ability es muy importante en este contexto, así que una “dependable motion” aporta una ventaja clara en la competencia. Los recursos limitados en “Labor/Cost” son la esencia tanto para desarrollar como para equipar el sistema de locomoción, entonces los 2 criterios son correlacionados negativamente, lo que refleja favorecimientos a soluciones que tengan buena performance en ambos criterios.




Resultados
Todas la información de arriba se usa para calcular la integral de Choquet (2) y los resultados son:

La alternativa de diseño \$DA\_1\$  tiene mayor puntaje.
La \$DA\_1\$ y la \$DA\_4\$ tienen las mismas características de performance pero en \$DA\_4\$ el costo y la complejidad son más altos (en ambas: 0.1 puntos para \$DA\_4\$ y 0.5 puntos para \$DA\_1\$)
Cálculo de la Integral de Choquet en este caso particular
No lo hace. Esta es mi resolución (en archivo ‘moulianitis2018.py’ en anexo en contenedor de Zotero.
Esta explicación de abajo es para la Design Alternative 1
Con Integral de Choquet:
Usando la fórmula (5) de (Grabisch, 1997) con los factores \${\textbackslash}mu({\textbackslash}mathcal\{T\})=f({\textbackslash}mu(\{x\_i, x\_j\}))\$, se tiene que con los pesos propuestos por el paper, da como resultado \${\textbackslash}mu({\textbackslash}mathcal\{X\}) = 1.04\$ donde \${\textbackslash}mathcal\{X\}\$ es el conjunto de todos los criterios. A cada valor peso \${\textbackslash}mu(x\_i, x\_j)\$ lo normalizo como \${\textbackslash}mu\_\{ij\} = {\textbackslash}mu\_\{ij\}/1.04\$ y \${\textbackslash}mu\_i = {\textbackslash}mu\_i/1.04\$. De esta forma \${\textbackslash}mu({\textbackslash}mathcal\{X\}) = 1\$
El método lo que hace es ordenar los criterios de menor puntaje a mayor puntaje para cada solución (eje vertical en la gráfica siguiente). 
Entonces aplica la integral:

Donde \$C\_{\textbackslash}mu\$ es el valor total de la integral, \${\textbackslash}Delta f = f(x\_i) - f(x\_\{i-1\})\$ es la diferencia de alto entre el puntaje \$i\$ y el anterior (alto de las barras horizontales en la gráfica), y \${\textbackslash}mu(A\_\{(i)\})\$ es el ancho de la barra, que es la medida fuzzy \${\textbackslash}mu\$ evaluada en el conjunto \$A\_\{(i)\} = {\textbackslash}\{x\_i {\textbackslash}dots x\_n{\textbackslash}\}\$. La primer evaluación, tiene el ancho total \${\textbackslash}mu({\textbackslash}mathcal\{X\})\$ y de alto 0.0 = \$f\_1 - 0\$ con \$x\_1 = {\textbackslash}\{{\textbackslash}text\{Interaction ability {\textbar} Adaptability\}{\textbackslash}\}\$.
Como \${\textbackslash}text\{"Decisional autonomy"\}\$ tiene efecto veto, todo lo que está por “arriba” se trunca.


Cuando hace \${\textbackslash}mu({\textbackslash}\{{\textbackslash}text\{Decisional autonomy, Complexity, Labor/cost\}{\textbackslash}\}){\textgreater}=0\$, y \${\textbackslash}Delta f = 0.05\$. OK.


El siguiente subconjunto sería \${\textbackslash}mu({\textbackslash}\{{\textbackslash}text\{Complexity, Labor/cost\}{\textbackslash}\})=0\$ porque el subconjunto entero ya no contiene a \${\textbackslash}text\{"Decisional autonomy"\}\$, con lo que trunca todo.


Con contribución Marginal:
Otra forma de ver la integral es con contribución marginal.
En este caso, los pesos de las interacciones son pensadas como una contribución marginal. Por ejemplo, la interacción:
\${\textbackslash}mu({\textbackslash}\{{\textbackslash}text\{Labor/cost, Complexity\}{\textbackslash}\}) = 0.30\$ se puede pensar como: \${\textbackslash}mu( {\textbackslash}\{ {\textbackslash}text\{Labor/cost\} {\textbackslash}\} ) + {\textbackslash}mu( {\textbackslash}\{ {\textbackslash}text\{Complexity\} {\textbackslash}\} ) + {\textbackslash}mu\_\{marg\}( {\textbackslash}\{ {\textbackslash}text\{Labor/cost, Complexity\} {\textbackslash}\} ) {\textbackslash}implies {\textbackslash}{\textbackslash} {\textbackslash}mu\_\{marg\}( {\textbackslash}\{ {\textbackslash}text\{Labor/cost, Complexity\} {\textbackslash}\} ) = a\_\{ij\} = 0.30 - 0.05 - 0.16=0.09\$
Entonces, la función de agregación se puede pensar como la suma pesada de los puntajes de cada criterio respecto al peso de cada criterio. Las contribuciones marginales también tienen su peso y el “puntaje” utilizado es el mínimo de los puntajes entre los criterios involucrados. En la gráfica de abajo los criterios fueron ordenados de mayor a menor para comparar mejor con la otra integral.

En caso que la contribución marginal sea negativa, el tamaño de la columna resta en vez de sumar. En este caso, la que resta se debe a la interacción positiva Configurability {\textless}-{\textgreater} Complexity con peso de -0.14. Notar que los pesos también fueron normalizados (factor 1/1.04) para que el ancho total sea 1 (usando los pesos negativos restantes en el ancho).
Comparación entre métodos
Superponiendo gráficas se ve que tienen la misma área, a excepción de la parte roja. Si se agregaran las columnas rojas hacia la izquierda en vez de a la derecha, “restaría” una buena parte del ancho del peso de Configurability respecto al eje \$y\$, quedando las 2 gráficas idénticas.

Mis resultados sobre las alternativas propuestas en el paper
Solamente da bien la \${\textbackslash}text\{DA\}\_1\$, el resto no. Para mí está mal el paper.

},
	file = {choquet.odp:/home/grolle/Zotero/storage/II5LMWQS/choquet.odp:application/vnd.oasis.opendocument.presentation;Moulianitis et al. - 2018 - A new index based on mechatronics abilities for th.pdf:/home/grolle/Zotero/storage/G7BWCKHE/Moulianitis et al. - 2018 - A new index based on mechatronics abilities for th.pdf:application/pdf;moulianitis2018.py:/home/grolle/Zotero/storage/WALXRPX4/moulianitis2018.py:text/plain},
