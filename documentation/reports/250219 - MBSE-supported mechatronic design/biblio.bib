},
	file = {2022_Vitolo Mobile Robots and Cobots Integration - Seminario SJJ - Sept2023.pdf:/home/grolle/Zotero/storage/JXJGXNTA/2022_Vitolo Mobile Robots and Cobots Integration - Seminario SJJ - Sept2023.pdf:application/pdf;2022_Vitolo Mobile Robots and Cobots Integration - Seminario SJJ - Sept2023.pptx:/home/grolle/Zotero/storage/VG77S6A7/2022_Vitolo Mobile Robots and Cobots Integration - Seminario SJJ - Sept2023.pptx:application/vnd.openxmlformats-officedocument.presentationml.presentation;Seminario GR - 2022_Vitolo Mobile Robots and Cobots Integration.odp:/home/grolle/Zotero/storage/YJIH37FT/Seminario GR - 2022_Vitolo Mobile Robots and Cobots Integration.odp:application/vnd.oasis.opendocument.presentation;Vitolo et al. - 2022 - Mobile Robots and Cobots Integration A Preliminar.pdf:/home/grolle/Zotero/storage/IRG5RWYQ/Vitolo et al. - 2022 - Mobile Robots and Cobots Integration A Preliminar.pdf:application/pdf},
