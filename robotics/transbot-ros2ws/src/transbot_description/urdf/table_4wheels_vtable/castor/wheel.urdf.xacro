<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="wheel">
	<xacro:macro name="wheel" params="prefix='' name='wheel' suffix=''">
		<link name="${prefix}${name}${suffix}">
			<inertial density="2500">
				<origin xyz="-5.043673381410886e-09 8.305118106012332e-11 -1.7919889451818913e-09" rpy="0 0 0"></origin>
				<mass value="0.4170796601101756"></mass>
				<inertia ixx="0.0004005272141209072" ixy="-1.3304174325500715e-12" ixz="-5.3873534573412926e-12" iyy="0.0004005273657033469" iyz="5.573319521545655e-12" izz="0.0007001058293098943"></inertia>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="package://transbot_description/meshes/table_4wheels_vtable/castor/wheel.stl" scale="1e-3 1e-3 1e-3"></mesh>
				</geometry>
				<material name="">
					<color rgba="0.2 0.2 0.2 1"></color>
				</material>
			</visual>
			<collision>
				<geometry>
					<mesh filename="package://transbot_description/meshes/table_4wheels_vtable/castor/wheel.stl" scale="1e-3 1e-3 1e-3"></mesh>
				</geometry>
			</collision>
		</link>
	</xacro:macro>
</robot>