<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="wheel">
	<xacro:macro name="wheel" params="prefix='' name='wheel' suffix=''">
		<link name="${prefix}${name}${suffix}">
			<inertial density="2500">
				<origin xyz="-1.4402941152869124e-09 -9.635928791275463e-11 -1.3427359559848857e-10" rpy="0 0 0"></origin>
				<mass value="0.49389696990450227"></mass>
				<inertia ixx="0.0005393656844413878" ixy="-1.6560826098533474e-12" ixz="-1.3026615867104015e-12" iyy="0.000539365805707347" iyz="1.181924992201764e-13" izz="0.0009120414082038516"></inertia>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file:$(find transbot_description)/meshes/robot_arm_gripper/mobilebase/castor/wheel.stl" scale="1e-3 1e-3 1e-3"></mesh>
				</geometry>
				<material name="">
					<color rgba="0.2 0.2 0.2 1"></color>
				</material>
			</visual>
			<collision>
				<geometry>
					<mesh filename="file:$(find transbot_description)/meshes/robot_arm_gripper/mobilebase/castor/wheel.stl" scale="1e-3 1e-3 1e-3"></mesh>
				</geometry>
			</collision>
		</link>
	</xacro:macro>
</robot>