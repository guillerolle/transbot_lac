<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="unna">
	<xacro:macro name="unna" params="prefix='' name='unna' suffix=''">
		<link name="${prefix}${name}${suffix}">
			<inertial density="7850">
				<origin xyz="0.19335801902328506 3.8987254598624655e-10 0.01535802775643009" rpy="0 0 0"></origin>
				<mass value="0.19440000566343466"></mass>
				<inertia ixx="0.0003702513319354325" ixy="1.465484115391557e-11" ixz="0.0006457186385303325" iyy="0.005511267229784068" iyz="2.76272489497312e-12" izz="0.005323265933474595"></inertia>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file:$(find transbot_description)/meshes/rigid_forklift/manipulator/unna.stl" scale="1e-3 1e-3 1e-3"></mesh>
				</geometry>
				<material name="">
					<color rgba="0.2 0.2 0.7 1"></color>
				</material>
			</visual>
			<collision>
				<geometry>
					<mesh filename="file:$(find transbot_description)/meshes/rigid_forklift/manipulator/unna.stl" scale="1e-3 1e-3 1e-3"></mesh>
				</geometry>
			</collision>
