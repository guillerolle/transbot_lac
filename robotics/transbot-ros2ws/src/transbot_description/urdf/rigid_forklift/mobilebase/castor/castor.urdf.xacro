<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mobilebase">
    <xacro:macro name="castor" params="prefix:='' use__all__='false'">

        <xacro:unless value="${use__all__}">
            <!-- ROOT LINK -->
            <link name="${prefix}_">
                <inertial>
                    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"></origin>
                    <mass value="0.07850000753630108"></mass>
                    <inertia ixx="6.542321560618129e-05" ixy="-0.0" ixz="-0.0" iyy="6.542321560618129e-05" iyz="-0.0" izz="0.00013083334787703887"></inertia>
                </inertial>
                <visual name="">
                    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                    <geometry>
                        <mesh filename="file:$(find transbot_description)/meshes/rigid_forklift/mobilebase/castor/_.stl" scale="1e-3 1e-3 1e-3"/>
                    </geometry>
                    <material name="">
                        <color rgba="1.0 1.0 1.0 1.0"/>
                        <texture filename=""/>
                    </material>
                </visual>
                <collision>
                    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                    <geometry>
                        <mesh filename="file:$(find transbot_description)/meshes/rigid_forklift/mobilebase/castor/_.stl" scale="1e-3 1e-3 1e-3"/>
                    </geometry>
                </collision>
            </link>
            <!-- ROOT LINK -->
            
            <!-- ARM -->
            <xacro:macro name="arm" params="prefix:='' suffix:=''">
                <link name="${prefix}arm${suffix}">
                    <inertial>
                        <origin xyz="0.023216224918960162 -8.969929176973099e-09 -0.023419614952871575" rpy="0.0 0.0 0.0"></origin>
                        <mass value="0.051559972992739254"></mass>
                        <inertia ixx="5.545925449285687e-05" ixy="-1.1492577484385438e-11" ixz="9.768022068599235e-06" iyy="3.537111428091728e-05" iyz="1.883664039156799e-12" izz="4.868920134631662e-05"></inertia>
                    </inertial>
                    <visual name="">
                        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                        <geometry>
                            <mesh filename="file:$(find transbot_description)/meshes/rigid_forklift/mobilebase/castor/arm.stl" scale="1e-3 1e-3 1e-3"/>
                        </geometry>
                        <material name="">
                            <color rgba="1.0 1.0 1.0 1.0"/>
                            <texture filename=""/>
                        </material>
                    </visual>
                    <collision>
                        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                        <geometry>
                            <mesh filename="file:$(find transbot_description)/meshes/rigid_forklift/mobilebase/castor/arm.stl" scale="1e-3 1e-3 1e-3"/>
                        </geometry>
                    </collision>
                </link>
            </xacro:macro> 

            <xacro:arm prefix="${prefix}"/>
            <joint name="${prefix}cj_dir" type="continuous">
                <origin xyz="0.0 0.0 -0.010" rpy="0.0 0.0 0.0"/>
                <axis xyz="0.0 0.0 1.0"/>
                <parent link="${prefix}_"/>
                <child link="${prefix}arm"/>
            </joint>
            <!-- END ARM -->

            <!-- WHEEL -->
            <xacro:macro name="wheel" params="prefix:='' suffix:=''">
                <link name="${prefix}wheel${suffix}">
                    <inertial>
                        <origin xyz="-9.060470524424798e-10 4.3399144291654343e-10 -1.3427359559848857e-10" rpy="0.0 0.0 0.0"></origin>
                        <mass value="3.877091213750343"></mass>
                        <inertia ixx="0.0042340201468959995" ixy="3.5314920758240293e-11" ixz="-1.0225893733800853e-11" iyy="0.004234021098833785" iyz="9.278108427825793e-13" izz="0.007159524102462451"></inertia>
                    </inertial>
                    <visual name="">
                        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                        <geometry>
                            <mesh filename="file:$(find transbot_description)/meshes/rigid_forklift/mobilebase/castor/wheel.stl" scale="1e-3 1e-3 1e-3"/>
                        </geometry>
                        <material name="">
                            <color rgba="1.0 1.0 1.0 1.0"/>
                            <texture filename=""/>
                        </material>
                    </visual>
                    <collision>
                        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                        <geometry>
                            <mesh filename="file:$(find transbot_description)/meshes/rigid_forklift/mobilebase/castor/wheel.stl" scale="1e-3 1e-3 1e-3"/>
                        </geometry>
                    </collision>
                </link>
            </xacro:macro> 

            <xacro:wheel prefix="${prefix}"/>
            <joint name="${prefix}cj_roll" type="continuous">
                <origin xyz="0.040 0.0 -0.060" rpy="1.57 0.0 0.0"/>
                <axis xyz="0.0 0.0 1.0"/>
                <parent link="${prefix}arm"/>
                <child link="${prefix}wheel"/>
            </joint>
            <!-- END WHEEL -->
        </xacro:unless>
    </xacro:macro>
</robot>