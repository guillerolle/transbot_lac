<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mobilebase">
    <xacro:macro name="diff" params="prefix:='' use__all__='false' suffix:=''">

        <xacro:unless value="${use__all__}">
            <!-- ROOT LINK -->
            <link name="${prefix}_${suffix}">
                <inertial>
                    <origin xyz="1.2249181909870052e-11 1.8496264683903782e-09 -1.6256482632337307e-11" rpy="0.0 0.0 0.0"></origin>
                    <mass value="1.5178593195741996"></mass>
                    <inertia ixx="0.04865975838377777" ixy="1.8592535262948404e-12" ixz="-2.8369957148953257e-14" iyy="7.534016428204873e-05" iyz="-9.761080878144008e-12" izz="0.04865975840608882"></inertia>
                </inertial>
                <visual name="">
                    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                    <geometry>
                        <mesh filename="file:$(find transbot_description)/meshes/rigid_forklift/mobilebase/diff/_.stl" scale="1e-3 1e-3 1e-3"/>
                    </geometry>
                    <material name="">
                        <color rgba="1.0 1.0 1.0 1.0"/>
                        <texture filename=""/>
                    </material>
                </visual>
                <collision>
                    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                    <geometry>
                        <mesh filename="file:$(find transbot_description)/meshes/rigid_forklift/mobilebase/diff/_.stl" scale="1e-3 1e-3 1e-3"/>
                    </geometry>
                </collision>
            </link>
            <!-- ROOT LINK -->
            
            <!-- WHEELS -->
            <xacro:macro name="wheel" params="prefix:='' suffix:=''">
                <link name="${prefix}wheel${suffix}">
                    <inertial>
                        <origin xyz="-1.1342320342034997e-09 3.0623937318460757e-10 -2.1101991334018597e-10" rpy="0.0 0.0 0.0"></origin>
                        <mass value="3.436210594372824"></mass>
                        <inertia ixx="0.0036396412584357063" ixy="6.504050795388836e-11" ixz="-2.788879415416694e-12" iyy="0.003639641020451255" iyz="-3.631576533261458e-15" izz="0.006362959934449459"></inertia>
                    </inertial>
                    <visual name="">
                        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                        <geometry>
                            <mesh filename="file:$(find transbot_description)/meshes/rigid_forklift/mobilebase/diff/wheel.stl" scale="1e-3 1e-3 1e-3"/>
                        </geometry>
                        <material name="">
                            <color rgba="1.0 1.0 1.0 1.0"/>
                            <texture filename=""/>
                        </material>
                    </visual>
                    <collision>
                        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                        <geometry>
                            <mesh filename="file:$(find transbot_description)/meshes/rigid_forklift/mobilebase/diff/wheel.stl" scale="1e-3 1e-3 1e-3"/>
                        </geometry>
                    </collision>
                </link>
            </xacro:macro> 
            <xacro:wheel prefix="${prefix}" suffix="0"/>
            <xacro:wheel prefix="${prefix}" suffix="1"/>
            <joint name="${prefix}cj0" type="continuous">
                <origin xyz="0.0 -0.280 0.0" rpy="-1.57 0.0 0.0"/>
                <axis xyz="0.0 0.0 1.0"/>
                <parent link="${prefix}_${suffix}"/>
                <child link="${prefix}wheel0${suffix}"/>
            </joint>
            <joint name="${prefix}cj1" type="continuous">
                <origin xyz="0.0 +0.280 0.0" rpy="+1.57 0.0 0.0"/>
                <axis xyz="0.0 0.0 1.0"/>
                <parent link="${prefix}_${suffix}"/>
                <child link="${prefix}wheel1${suffix}"/>
            </joint>
        </xacro:unless>
    </xacro:macro>
</robot>