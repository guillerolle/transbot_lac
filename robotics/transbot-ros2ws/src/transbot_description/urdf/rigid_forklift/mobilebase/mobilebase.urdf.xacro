<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mobilebase">
    <xacro:arg name="use__all__" default="false"/>

    <xacro:macro name="mobilebase" params="prefix:='' use__all__='false'">
        <!-- __all__ is used for schematic-rigid complete robot, exported from openscad -->
        <xacro:if value="${use__all__}">
            <link name="${prefix}__all__">
                <inertial>
                    <origin xyz="0.1432753349846481 0.06287308442628833 0.3382081195656269" rpy="0.0 0.0 0.0"></origin>
                    <mass value="132.728783848385"></mass>
                    <inertia ixx="22.10556312699262" ixy="-0.10445688329743485" ixz="-3.1813848924270305" iyy="23.414765722195412" iyz="0.33707093907462804" izz="10.122101490301148"></inertia>
                </inertial>
                <visual name="">
                    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                    <geometry>
                        <mesh filename="file:$(find transbot_description)/meshes/rigid_forklift/mobilebase/__all__.stl" scale="1e-3 1e-3 1e-3"/>
                    </geometry>
                    <material name="">
                        <color rgba="1.0 1.0 1.0 1.0"/>
                        <texture filename=""/>
                    </material>
                </visual>
                <collision>
                    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                    <geometry>
                        <mesh filename="file:$(find transbot_description)/meshes/rigid_forklift/mobilebase/__all__.stl" scale="1e-3 1e-3 1e-3"/>
                    </geometry>
                </collision>
            </link>
        </xacro:if>

        <xacro:unless value="${use__all__}">
            <link name="${prefix}_">
                <!-- ROOT LINK IS EMPTY -->
            </link>

            <!-- CHASSIS -->
            <xacro:macro name="chassis" params="prefix:='' suffix:=''">
                <link name="${prefix}chassis${suffix}">
                    	<inertial>
                            <origin xyz="-4.214782625114979e-07 -8.429565250229957e-08 0.12852128229197857" rpy="0.0 0.0 0.0"></origin>
                            <mass value="7.2274211794137955"></mass>
                            <inertia ixx="0.530181129810451" ixy="-9.138577085264952e-08" ixz="-6.351977221947287e-07" iyy="0.7230887180163814" iyz="-5.047684586600736e-07" izz="0.9892317251056117"></inertia>
                        </inertial>
                    <visual name="">
                        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                        <geometry>
                            <mesh filename="file:$(find transbot_description)/meshes/rigid_forklift/mobilebase/chassis.stl" scale="1e-3 1e-3 1e-3"/>
                        </geometry>
                        <material name="">
                            <color rgba="1.0 1.0 1.0 1.0"/>
                            <texture filename=""/>
                        </material>
                    </visual>
                    <collision>
                        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                        <geometry>
                            <mesh filename="file:$(find transbot_description)/meshes/rigid_forklift/mobilebase/chassis.stl" scale="1e-3 1e-3 1e-3"/>
                        </geometry>
                    </collision>
                </link>
            </xacro:macro>
            <xacro:chassis prefix="${prefix}"/>
            <joint name='${prefix}fj_chassis' type='fixed'>
                <origin xyz="0.0 0.0 0.130" rpy="0.0 0.0 0.0"/>
                <parent link="${prefix}_"/>
                <child link="${prefix}chassis"/>
            </joint>
            <!-- END CHASSIS -->

            <!-- CONTROL PLATE -->
            <xacro:macro name="control" params="prefix:='' suffix:=''">
                <link name="${prefix}control${suffix}">
                    <inertial>
                        <origin xyz="0.11800876511481027 0.09354560312818934 0.10163800234275462" rpy="0.0 0.0 0.0"></origin>
                        <mass value="89.20855447649956"></mass>
                        <inertia ixx="1.5876188372474913" ixy="-0.31530885890237215" ixz="-0.2653848230310907" iyy="1.4073346625382324" iyz="-0.21846570819508548" izz="1.995414153698111"></inertia>
                    </inertial>
                    <visual name="">
                        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                        <geometry>
                            <mesh filename="file:$(find transbot_description)/meshes/rigid_forklift/mobilebase/control.stl" scale="1e-3 1e-3 1e-3"/>
                        </geometry>
                        <material name="">
                            <color rgba="1.0 1.0 1.0 1.0"/>
                            <texture filename=""/>
                        </material>
                    </visual>
                    <collision>
                        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                        <geometry>
                            <mesh filename="file:$(find transbot_description)/meshes/rigid_forklift/mobilebase/control.stl" scale="1e-3 1e-3 1e-3"/>
                        </geometry>
                    </collision>
                </link>
            </xacro:macro>
            <xacro:control prefix="${prefix}"/>
            <joint name='${prefix}pj_control' type='prismatic'>
                <origin xyz="0.0 0.0 0.170" rpy="0.0 0.0 0.0"/>
                <parent link="${prefix}_"/>
                <child link="${prefix}control"/>
                <axis xyz="1.0 0.0 0.0"/> 
                <limit lower="0.0" upper="0.500" effort="0.0" velocity="0.0"/>
            </joint>
            <!-- END CONTROL PLATE -->

            <!-- DIFFERENTIAL DRIVE MODULE -->
            <xacro:include filename="$(find transbot_description)/urdf/rigid_forklift/mobilebase/diff/diff.urdf.xacro"/>
            <xacro:diff prefix="${prefix}diff/"/>
            <joint name='${prefix}fj_diffmodule' type='fixed'>
                <origin xyz="-0.310 0.0 0.060" rpy="0.0 0.0 0.0"/>
                <parent link="${prefix}_"/>
                <child link="${prefix}diff/_"/>
            </joint>
            <!-- END DIFFERENTIAL DRIVE MODULE -->

            <!-- CASTOR WHEELS -->
            <xacro:include filename="$(find transbot_description)/urdf/rigid_forklift/mobilebase/castor/castor.urdf.xacro"/>
            
            <xacro:castor prefix="${prefix}castor0/"/>
            <joint name='${prefix}fj_castor0' type='fixed'>
                <origin xyz="0.350 0.250 0.130" rpy="0.0 0.0 0.0"/>
                <parent link="${prefix}_"/>
                <child link="${prefix}castor0/_"/>
            </joint>

            <xacro:castor prefix="${prefix}castor1/"/>
            <joint name='${prefix}fj_castor1' type='fixed'>
                <origin xyz="0.350 -0.250 0.130" rpy="0.0 0.0 0.0"/>
                <parent link="${prefix}_"/>
                <child link="${prefix}castor1/_"/>
            </joint>
            <!-- END CASTOR WHEELS -->
        </xacro:unless>
    </xacro:macro> 
    <!--xacro:mobilebase prefix="" use__all__="$(arg use__all__)"/-->
</robot>