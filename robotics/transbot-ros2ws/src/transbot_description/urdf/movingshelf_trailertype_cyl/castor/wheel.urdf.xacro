<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="wheel">
	<xacro:macro name="wheel" params="prefix='' name='wheel' suffix=''">
		<link name="${prefix}${name}${suffix}">
			<inertial density="2500">
				<origin xyz="-3.5666412972002695e-10 2.9372340094590455e-10 -2.7766040245667537e-10" rpy="0 0 0"></origin>
				<mass value="0.45156308139363927"></mass>
				<inertia ixx="0.0004658728509336166" ixy="-2.25005204387967e-12" ixz="2.386979950133806e-13" iyy="0.00046587291156659666" iyz="-3.682738863511243e-20" izz="0.0008113289974668683"></inertia>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="package://transbot_description/meshes/movingshelf_trailertype_cyl/castor/wheel.stl" scale="1e-3 1e-3 1e-3"></mesh>
				</geometry>
				<material name="">
