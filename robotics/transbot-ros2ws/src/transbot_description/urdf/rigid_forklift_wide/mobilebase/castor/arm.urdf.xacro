<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="arm">
	<xacro:macro name="arm" params="prefix='' name='arm' suffix=''">
		<link name="${prefix}${name}${suffix}">
			<inertial density="7850">
				<origin xyz="0.023216223476559487 -1.1854730520321233e-08 -0.023419604856066874" rpy="0 0 0"></origin>
				<mass value="0.006568149425826657"></mass>
				<inertia ixx="7.064875816359493e-06" ixy="-1.7161063013112547e-12" ixz="1.2443357829905416e-06" iyy="4.505877976838242e-06" iyz="-1.3739065952639405e-12" izz="6.202445997578881e-06"></inertia>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file:$(find transbot_description)/meshes/rigid_forklift_wide/mobilebase/castor/arm.stl" scale="1e-3 1e-3 1e-3"></mesh>
				</geometry>
				<material name="">
					<color rgba="1 1 1 1"></color>
				</material>
			</visual>
			<collision>
				<geometry>
					<mesh filename="file:$(find transbot_description)/meshes/rigid_forklift_wide/mobilebase/castor/arm.stl" scale="1e-3 1e-3 1e-3"></mesh>
				</geometry>
			</collision>
		</link>
	</xacro:macro>
</robot>