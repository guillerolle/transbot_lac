<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="horquilla">
	<xacro:macro name="horquilla" params="prefix='' name='horquilla' suffix=''">
		<link name="${prefix}${name}${suffix}">
			<inertial density="7850">
				<origin xyz="0.060795572404041945 0.0 -3.4450586239838345e-10" rpy="0 0 0"></origin>
				<mass value="0.43999962508678436"></mass>
				<inertia ixx="0.03907060154233477" ixy="-0.0" ixz="-4.47859026038743e-12" iyy="0.0007991720879035426" iyz="-0.0" izz="0.03913643974548053"></inertia>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="file:$(find transbot_description)/meshes/rigid_forklift_wide/manipulator/horquilla.stl" scale="1e-3 1e-3 1e-3"></mesh>
				</geometry>
				<material name="">
					<color rgba="0.2 0.7 0.2 1"></color>
				</material>
			</visual>
			<collision>
				<geometry>
					<mesh filename="file:$(find transbot_description)/meshes/rigid_forklift_wide/manipulator/horquilla.stl" scale="1e-3 1e-3 1e-3"></mesh>
				</geometry>
			</collision>
		</link>
	</xacro:macro>
</robot>