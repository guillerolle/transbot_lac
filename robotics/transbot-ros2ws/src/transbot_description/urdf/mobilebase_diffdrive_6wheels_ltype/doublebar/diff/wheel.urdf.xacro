				<inertia ixx="0.0004636484770041231" ixy="-5.443562252749146e-12" ixz="-3.5527139229974206e-13" iyy="0.0004636485376371031" iyz="4.62581060690524e-16" izz="0.0008105680535663851"></inertia>
