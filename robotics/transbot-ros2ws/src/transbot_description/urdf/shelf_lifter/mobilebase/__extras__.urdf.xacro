<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mobilebase">
	<xacro:macro name="mobilebase-extras-description" params="prefix='' name='mobilebase' suffix=''">
		<link name="drive_link"></link>
		<joint name="j/drive_link" type="fixed">
			<origin xyz="0.23 0.0 0.0" rpy="0.0 0.0 0.0"></origin>
			<parent link="drive_link"></parent>
			<child link="_"></child>
		</joint>
	</xacro:macro>
</robot>