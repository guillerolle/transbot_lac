<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="shelf_lifter">
	<xacro:macro name="shelf_lifter" params="prefix='' name='shelf_lifter' suffix=''">
		<link name="${prefix}${name}${suffix}_"></link>
		<xacro:include filename="$(find transbot_description)/urdf/shelf_lifter//__extras__.urdf.xacro"></xacro:include>
		<xacro:include filename="$(find transbot_description)/urdf/shelf_lifter/mobilebase/mobilebase.urdf.xacro"></xacro:include>
		<xacro:include filename="$(find transbot_description)/urdf/shelf_lifter/lifter.urdf.xacro"></xacro:include>
		<xacro:include filename="$(find transbot_description)/urdf/shelf_lifter/camera.urdf.xacro"></xacro:include>
		<xacro:include filename="$(find transbot_description)/urdf/shelf_lifter/lidar.urdf.xacro"></xacro:include>
		<xacro:include filename="$(find transbot_description)/urdf/shelf_lifter/imu.urdf.xacro"></xacro:include>
		<joint name="j/${prefix}${name}${suffix}mobilebase/_" type="fixed">
			<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"></origin>
			<parent link="${prefix}${name}${suffix}_"></parent>
			<child link="${prefix}${name}${suffix}mobilebase/_"></child>
		</joint>
		<joint name="j/${prefix}${name}${suffix}lifter" type="prismatic">
			<origin xyz="0.0 0.0 0.3" rpy="0.0 0.0 0.0"></origin>
			<parent link="${prefix}${name}${suffix}_"></parent>
			<child link="${prefix}${name}${suffix}lifter"></child>
			<axis xyz="0 0 1"></axis>
			<limit lower="-0.005" upper="0.1" effort="1000000.0" velocity="1000000.0"></limit>
		</joint>
		<joint name="j/${prefix}${name}${suffix}camera" type="fixed">
			<origin xyz="-0.375 0.0 0.6" rpy="0.0 0.08726646259971647 0.0"></origin>
			<parent link="${prefix}${name}${suffix}_"></parent>
			<child link="${prefix}${name}${suffix}camera"></child>
		</joint>
		<joint name="j/${prefix}${name}${suffix}lidar" type="fixed">
			<origin xyz="0.275 0.0 0.18" rpy="0.0 0.0 0.0"></origin>
			<parent link="${prefix}${name}${suffix}_"></parent>
			<child link="${prefix}${name}${suffix}lidar"></child>
		</joint>
		<joint name="j/${prefix}${name}${suffix}imu" type="fixed">
			<origin xyz="0.275 -0.25 0.18" rpy="0.0 0.0 0.0"></origin>
			<parent link="${prefix}${name}${suffix}_"></parent>
			<child link="${prefix}${name}${suffix}imu"></child>
		</joint>
		<xacro:shelf_lifter-extras-description prefix="${prefix}${name}${suffix}"></xacro:shelf_lifter-extras-description>
		<xacro:mobilebase prefix="${prefix}${name}${suffix}" suffix="/"></xacro:mobilebase>
		<xacro:lifter prefix="${prefix}${name}${suffix}" suffix=""></xacro:lifter>
		<xacro:camera prefix="${prefix}${name}${suffix}" suffix=""></xacro:camera>
		<xacro:lidar prefix="${prefix}${name}${suffix}" suffix=""></xacro:lidar>
		<xacro:imu prefix="${prefix}${name}${suffix}" suffix=""></xacro:imu>
	</xacro:macro>
</robot>