<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="wheel">
	<xacro:macro name="wheel" params="prefix='' name='wheel' suffix=''">
		<link name="${prefix}${name}${suffix}">
			<inertial density="2500">
				<origin xyz="6.398975191828604e-10 -2.0980246530585588e-10 -2.7766045017821864e-10" rpy="0 0 0"></origin>
				<mass value="0.4515630037834247"></mass>
				<inertia ixx="0.0004658728812501066" ixy="4.500103932524029e-12" ixz="2.3869787006329817e-13" iyy="0.0004658728509336164" iyz="2.6305282117601664e-20" izz="0.0008113289671503781"></inertia>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="package://transbot_description/meshes/movingshelf_trailertype/castor/wheel.stl" scale="1e-3 1e-3 1e-3"></mesh>
				</geometry>
				<material name="">
					<color rgba="0.2 0.2 0.2 1"></color>
				</material>
			</visual>
			<collision>
				<geometry>
					<mesh filename="package://transbot_description/meshes/movingshelf_trailertype/castor/wheel.stl" scale="1e-3 1e-3 1e-3"></mesh>
				</geometry>
			</collision>
