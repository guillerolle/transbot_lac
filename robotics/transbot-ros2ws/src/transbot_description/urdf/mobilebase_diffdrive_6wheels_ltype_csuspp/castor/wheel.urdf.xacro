				<inertia ixx="0.00047094981709960837" ixy="1.3338405202687647e-11" ixz="-2.979080447543647e-13" iyy="0.0004709493926687267" iyz="-3.6341299692548287e-12" izz="0.0008008172396026965"></inertia>
