<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="wheel">
	<xacro:macro name="wheel" params="prefix='' name='wheel' suffix=''">
		<link name="${prefix}${name}${suffix}">
			<inertial density="2500">
				<origin xyz="8.279372638091937e-09 4.4512090026054606e-10 -1.1682846287274986e-09" rpy="0 0 0"></origin>
				<mass value="0.403250684030354"></mass>
				<inertia ixx="0.0003983031244085086" ixy="3.580484115501506e-13" ixz="-2.410749115073258e-12" iyy="0.00039830279092709043" iyz="4.680977617874207e-12" izz="0.0006993444609785331"></inertia>
			</inertial>
			<visual>
				<geometry>
					<mesh filename="package://transbot_description/meshes/diffdrive_6wheels_vtable/doublebar/diff/wheel.stl" scale="1e-3 1e-3 1e-3"></mesh>
				</geometry>
				<material name="">
					<color rgba="0.2 0.2 0.2 1"></color>
				</material>
			</visual>
			<collision>
				<geometry>
					<mesh filename="package://transbot_description/meshes/diffdrive_6wheels_vtable/doublebar/diff/wheel.stl" scale="1e-3 1e-3 1e-3"></mesh>
				</geometry>
			</collision>
		</link>
	</xacro:macro>
</robot>