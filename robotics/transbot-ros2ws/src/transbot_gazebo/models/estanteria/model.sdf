<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="estanteria">
    <static>true</static>    
    <link name="estanteria">
      <visual name="visual">
        <geometry>
            <mesh>
              <uri>meshes/estanteria.stl</uri>
              <scale>1e-3 1e-3 1e-3</scale>
            </mesh>
        </geometry>
        <!-- Opcional: aplicar material -->
        <material>
          <diffuse>0.8 0.8 0.2 1.0</diffuse>
        </material>
      </visual>
      
      <collision name="collision">
        <geometry>
            <mesh>
              <uri>meshes/estanteria.stl</uri>
              <scale>1e-3 1e-3 1e-3</scale>
            </mesh>
        </geometry>
      </collision>
      
      <inertial>
        <mass>10.0</mass>
        <inertia>
          <ixx>0.1</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.1</iyy>
          <iyz>0.0</iyz>
          <izz>0.1</izz>
        </inertia>
      </inertial>
    </link>
    
    <!-- Más links (brazos, ruedas, etc.) -->
    
  </model>
</sdf>