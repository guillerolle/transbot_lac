<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rigid_forklift_dsusp_rr_inner">
	<xacro:include filename="$(find transbot_gazebo)/urdf/rigid_forklift_dsusp_rr_inner/mobilebase/mobilebase.urdf.xacro"></xacro:include>
	<xacro:include filename="$(find transbot_gazebo)/urdf/rigid_forklift_dsusp_rr_inner/manipulator/manipulator.urdf.xacro"></xacro:include>
	<xacro:macro name="rigid_forklift_dsusp_rr_inner-ros2_control_gazebo" params="prefix='' name='rigid_forklift_dsusp_rr_inner' suffix=''">
		<joint name="j/${prefix}${name}${suffix}manipulator/_">
			<state_interface name="position">
				<param name="initial_value">0.0</param>
			</state_interface>
			<state_interface name="velocity"></state_interface>
			<state_interface name="effort"></state_interface>
			<command_interface name="velocity"></command_interface>
			<command_interface name="effort"></command_interface>
		</joint>
		<xacro:mobilebase-ros2_control_gazebo prefix="${prefix}${name}${suffix}" suffix="/"></xacro:mobilebase-ros2_control_gazebo>
		<xacro:manipulator-ros2_control_gazebo prefix="${prefix}${name}${suffix}" suffix="/"></xacro:manipulator-ros2_control_gazebo>
	</xacro:macro>
	<xacro:macro name="rigid_forklift_dsusp_rr_inner-gz_reference" params="prefix='' name='rigid_forklift_dsusp_rr_inner' suffix=''">
		<xacro:mobilebase-gz_reference prefix="${prefix}${name}${suffix}" suffix="/"></xacro:mobilebase-gz_reference>
		<xacro:manipulator-gz_reference prefix="${prefix}${name}${suffix}" suffix="/"></xacro:manipulator-gz_reference>
	</xacro:macro>
</robot>