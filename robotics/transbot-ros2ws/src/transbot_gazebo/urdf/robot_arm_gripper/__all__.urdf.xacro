<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot_arm_gripper">
	<xacro:arg name="ros2_control_namespace" default="/transbot"></xacro:arg>
	<xacro:arg name="ros2_control_dict" default="robot_arm_gripper//ros2_control.yaml"></xacro:arg>
	<xacro:include filename="$(find transbot_description)/urdf/robot_arm_gripper/__all__.urdf.xacro"></xacro:include>
	<xacro:include filename="$(find transbot_gazebo)/urdf/robot_arm_gripper/robot_arm_gripper.urdf.xacro"></xacro:include>
	<gazebo>
		<plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
			<parameters>$(find transbot_gazebo)/config/$(arg ros2_control_dict)</parameters>
			<ros>
				<namespace>$(arg ros2_control_namespace)</namespace>
			</ros>
		</plugin>
	</gazebo>
	<xacro:robot_arm_gripper-gz_reference prefix="" name=""></xacro:robot_arm_gripper-gz_reference>
	<ros2_control name="GazeboSimSystem" type="system">
		<hardware>
			<plugin>gz_ros2_control/GazeboSimSystem</plugin>
		</hardware>
		<xacro:robot_arm_gripper-ros2_control_gazebo prefix="" name=""></xacro:robot_arm_gripper-ros2_control_gazebo>
	</ros2_control>
</robot>