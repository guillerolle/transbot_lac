<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mobilebase_diffdrive_6wheels_ltype">
	<xacro:macro name="mobilebase_diffdrive_6wheels_ltype-extras-gazebo" params="prefix='' name='mobilebase_diffdrive_6wheels_ltype' suffix=''">
		<gazebo reference="${prefix}${name}${prefix}camera">
			<sensor name="camera" type="camera">
				<always_on>true</always_on>
				<update_rate>30</update_rate>
				<topic>model/$(arg robot_name)/camera/image_raw</topic>
				<gz_frame_id>${prefix}${name}${prefix}camera</gz_frame_id>
				<camera>
					<horizontal_fov>1.396</horizontal_fov>
					<image>
						<width>640</width>
						<height>480</height>
					<format>R8G8B8</format>
					</image>
					<clip>
						<near>0.05</near>
						<far>50</far>
					</clip>
				</camera>
			</sensor>
		</gazebo>
	</xacro:macro>
</robot>