<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="movingshelf_trailertype_cyl">
	<xacro:include filename="$(find transbot_gazebo)/urdf/movingshelf_trailertype_cyl/castor/castor.urdf.xacro"></xacro:include>
	<xacro:macro name="movingshelf_trailertype_cyl-ros2_control_gazebo" params="prefix='' name='movingshelf_trailertype_cyl' suffix=''">
		<xacro:castor-ros2_control_gazebo prefix="${prefix}${name}${suffix}" suffix="0/"></xacro:castor-ros2_control_gazebo>
		<xacro:castor-ros2_control_gazebo prefix="${prefix}${name}${suffix}" suffix="1/"></xacro:castor-ros2_control_gazebo>
	</xacro:macro>
	<xacro:macro name="movingshelf_trailertype_cyl-gz_reference" params="prefix='' name='movingshelf_trailertype_cyl' suffix=''">
		<xacro:castor-gz_reference prefix="${prefix}${name}${suffix}" suffix="0/"></xacro:castor-gz_reference>
		<xacro:castor-gz_reference prefix="${prefix}${name}${suffix}" suffix="1/"></xacro:castor-gz_reference>
	</xacro:macro>
</robot>