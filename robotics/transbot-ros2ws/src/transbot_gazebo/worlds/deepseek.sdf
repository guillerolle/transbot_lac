<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="simple_arena">
    <!-- EMPTY.SDF -->
    <physics name="" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-contact-system"
      name="gz::sim::systems::Contact">
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <!-- END EMPTY.SDF -->
    
    <!-- A wall -->
    <model name="far_wall">
      <static>true</static>
      <link name="wall">
        <pose>10.25 0 1 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.5 20.0 2.0</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.15 0.15 1</ambient>
            <diffuse>0.5 0.15 0.15 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.5 20.0 2.0</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>
    
    <!-- Add more objects here -->
    <include>
        <uri>package://transbot_gazebo/models/canasto/</uri>
        <pose>5 0 1.1 0 0 1.57</pose>
    </include>

    <!-- Add more objects here -->
    <include>
        <uri>package://transbot_gazebo/models/estanteria</uri>
        <pose>5 0 0 0 0 0</pose>
    </include>    
    <include>
        <uri>package://transbot_gazebo/models/estanteria</uri>
        <name>estanteria2</name>
        <pose>5 2 0 0 0 0</pose>
    </include>

  </world>
</sdf>