  connect(w1f_phid, mSf_phi1.u) annotation(
    Line(points = {{-302, 144}, {-260, 144}, {-260, 130}}, color = {0, 0, 127}));
  connect(mSf_phi0.bondCon, w0f.p_phid) annotation(
    Line(points = {{-224, -120}, {-180, -120}}));
  connect(w0f_phid, mSf_phi0.u) annotation(
