  Modelica.Blocks.Interfaces.RealInput w0f_phid annotation(
    Placement(transformation(origin = {-301, -81}, extent = {{-9, -9}, {9, 9}}), iconTransformation(origin = {-100, -60}, extent = {{-11, -11}, {11, 11}})));
  Modelica.Blocks.Interfaces.RealOutput z[3] annotation(
