  connect(j12.bondConJ3, bond81.bondCon1) annotation(
    Line(points = {{30, -32}, {62, -32}}));
  connect(bond10.bondCon2, j12.bondConJ1) annotation(
    Line(points = {{-10, 104}, {20, 104}, {20, -22}}));
  connect(bond101.bondCon2, j12.bondConJ2) annotation(
    Line(points = {{-10, -136}, {20, -136}, {20, -42}}));
  connect(mSf_phi1.bondCon, w1f.p_phid) annotation(
