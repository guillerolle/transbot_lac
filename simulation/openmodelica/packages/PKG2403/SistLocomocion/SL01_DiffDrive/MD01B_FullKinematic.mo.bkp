  connect(bond3.bondCon2, pointRigidBody2D1.p_vypoint) annotation(
    Line(points = {{-100, -136}, {-80, -136}}));
  connect(j1.bondConJ3, bond4.bondCon1) annotation(
    Line(points = {{9.8, 0}, {41.8, 0}}));
  connect(bond4.bondCon2, chasis.p_omega) annotation(
    Line(points = {{59, 0}, {100, 0}}));
  connect(pointRigidBody2D.p_omegabody, bond5.bondCon1) annotation(
