within PKG2403.SistLocomocion.SL01_DiffDrive;

model MD01B_FullKinematic
  parameter Real a = 0.5 "distancia en x entre cm y ruedas", b = 0.2 "distancia en y entre cm y rueda", r = 0.12 "wheel radius";
  Componentes.Chasis chasis annotation(
    Placement(transformation(origin = {140, 0}, extent = {{-40, -40}, {40, 40}})));
  Componentes.FixedWheel w1f(r = r) annotation(
    Placement(transformation(origin = {-160, 120}, extent = {{20, -20}, {-20, 20}})));
  SistLocomocion.Componentes.FixedWheel w0f(r = r) annotation(
