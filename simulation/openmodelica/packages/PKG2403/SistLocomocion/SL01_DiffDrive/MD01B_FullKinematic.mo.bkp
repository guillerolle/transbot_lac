  connect(bond5.bondCon2, j1.bondConJ1) annotation(
    Line(points = {{-11, 120}, {0, 120}, {0, 10}}));
  connect(pointRigidBody2D1.p_omegabody, bond6.bondCon1) annotation(
    Line(points = {{-40, -120}, {-29, -120}}));
  connect(bond6.bondCon2, j1.bondConJ2) annotation(
    Line(points = {{-11, -120}, {0, -120}, {0, -10}}));
  connect(pointRigidBody2D.p_vxbody, bond7.bondCon1) annotation(
    Line(points = {{-40, 136}, {-28, 136}}));
  connect(bond8.bondCon2, chasis.p_vxlocal) annotation(
    Line(points = {{80, 32}, {100, 32}}));
  connect(bond8.bondCon1, j11.bondConJ3) annotation(
    Line(points = {{62, 32}, {50, 32}}));
  connect(bond7.bondCon2, j11.bondConJ1) annotation(
    Line(points = {{-10, 136}, {40, 136}, {40, 42}}));
  connect(pointRigidBody2D1.p_vxbody, bond9.bondCon1) annotation(
