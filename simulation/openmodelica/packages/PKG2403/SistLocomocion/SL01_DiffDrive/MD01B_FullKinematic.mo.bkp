MD01B: FK"), Text(origin = {-105, 83}, extent = {{-21, 17}, {21, -17}}, textString = "phi1d"), Text(origin = {-103, -81}, extent = {{-21, 17}, {21, -17}}, textString = "phi0d"), Text(origin = {95, 85}, extent = {{-21, 17}, {21, -17}}, textString = "z"), Text(origin = {97, -83}, extent = {{-21, 17}, {21, -17}}, textString = "zdot"), Text(origin = {-4, -64}, textColor = {0, 85, 255}, extent = {{-86, 28}, {86, -28}}, textString = "%name")}, coordinateSystem(extent = {{-100, -100}, {100, 100}})));
end MD01B_FullKinematic;