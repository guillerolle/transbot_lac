  Modelica.Blocks.Interfaces.RealOutput zdot[3] annotation(
    Placement(transformation(origin = {224, -8}, extent = {{-10, -10}, {10, 10}}), iconTransformation(origin = {100, -60}, extent = {{-10, -10}, {10, 10}})));
equation
  connect(sf.bondCon, w1f.p_cpvx) annotation(
    Line(points = {{-188, 136}, {-180, 136}}));
  connect(sf1.bondCon, w1f.p_cpvy) annotation(
    Line(points = {{-188, 104}, {-180, 104}}));
  connect(sf3.bondCon, w0f.p_cpvx) annotation(
    Line(points = {{-186, -104}, {-180, -104}}));
  connect(se.bondCon, w0f.p_cpvy) annotation(
    Line(points = {{-194, -136}, {-180, -136}}));
  connect(se1.bondCon, chasis.p_vxglobal) annotation(
    Line(points = {{197, 80}, {187.8, 80}, {187.8, 30}, {180.8, 30}}));
  connect(se11.bondCon, chasis.p_vyglobal) annotation(
    Line(points = {{195, -80}, {187.8, -80}, {187.8, -30}, {180.8, -30}}));
