      vertex -50 50 -0.5
    endloop
  endfacet
  facet normal -1 -0 0
    outer loop
      vertex -50 50 0.5
      vertex -50 -50 -0.5
      vertex -50 -50 0.5
    endloop
  endfacet
  facet normal 0 -1 0
    outer loop
      vertex -50 -50 -0.5
      vertex 50 -50 0.5
      vertex -50 -50 0.5
    endloop
  endfacet
  facet normal 0 -1 -0
    outer loop
      vertex 50 -50 0.5
      vertex -50 -50 -0.5
      vertex 50 -50 -0.5
    endloop
  endfacet
  facet normal 0 1 -0
    outer loop
      vertex 50 50 -0.5
      vertex -50 50 0.5
      vertex 50 50 0.5
    endloop
  endfacet
  facet normal 0 1 0
    outer loop
      vertex -50 50 0.5
      vertex 50 50 -0.5
      vertex -50 50 -0.5
    endloop
  endfacet
endsolid OpenSCAD_Model
