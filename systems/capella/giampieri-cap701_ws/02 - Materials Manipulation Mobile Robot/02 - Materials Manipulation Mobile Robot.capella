              ReqIFLongName="Debe superar pendientes de hasta 15°"/>
          <ownedRequirements xsi:type="Requirements:Requirement" id="36084090-14cf-430d-bc1e-43fa9b619081"
              ReqIFLongName="Debe navegar dentro de los senderos que son de 80cm de ancho">
