          <ownedRequirements xsi:type="Requirements:Requirement" id="671f57ac-1f0c-4dfb-8b40-efbf4821fbce"
              ReqIFLongName="El sistema debe transportar insumos de producción" ReqIFName=""
              ReqIFPrefix="" requirementType="#8b9c11e2-dad0-4dbf-81de-2fe7d7e37c7a"
              ReqIFText="&lt;p>El sistema debe transportar materiales (entre otras): bolsas con resortes de 30kg c/u de tama&amp;ntilde;o 50cm x 50cm x 15cm; bolsas grimar de22kg c/u; bolsas de estanter&amp;iacute;a de 20kg c/u&lt;/p>&#xA;">
            <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                id="27629eb4-699d-4e40-a711-37ce765bc287" relationType="#a81b1a78-454b-47a6-9f08-6ad263e72029"
                source="#671f57ac-1f0c-4dfb-8b40-efbf4821fbce"/>
            <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                id="fda8a18e-6bf8-4ffa-a6fb-2522513cd09c" relationType="#a81b1a78-454b-47a6-9f08-6ad263e72029"
                source="#671f57ac-1f0c-4dfb-8b40-efbf4821fbce" target="#b84c099e-da1b-455b-8ae5-93c98afcf7b4"/>
          </ownedRequirements>
          <ownedRequirements xsi:type="Requirements:Requirement" id="86e7d60a-d1af-438d-9a2c-65b5604a2f13"
              ReqIFLongName="El sistema debe navegar por los senderos de circulación de la fábrica">
            <ownedRelations xsi:type="CapellaRequirements:CapellaIncomingRelation"
                id="e9bf6d83-0884-4344-98f5-6121c5d19aea" relationType="#a81b1a78-454b-47a6-9f08-6ad263e72029"
                source="#86e7d60a-d1af-438d-9a2c-65b5604a2f13" target="#70deeb8d-71a7-4f30-a821-94d9f105e350"/>
          </ownedRequirements>
          <ownedRequirements xsi:type="Requirements:Requirement" id="1fc06c9d-22c3-44d3-9e76-86d4b8707a25"
              ReqIFLongName="El sistema debe ser ergonómico"/>
          <ownedRequirements xsi:type="Requirements:Requirement" id="1d6e0dc0-30f2-430d-8b82-5f3d80733af2"
              ReqIFName="Eficiente"/>
        </ownedRequirements>
        <ownedRequirements xsi:type="Requirements:Folder" id="156fa760-91e4-4343-add9-1abb9398ab80"
            ReqIFLongName="Requerimientos del Entorno">
          <ownedRequirements xsi:type="Requirements:Requirement" id="d55501b4-ee22-45fd-8dc6-6464724663ad"
