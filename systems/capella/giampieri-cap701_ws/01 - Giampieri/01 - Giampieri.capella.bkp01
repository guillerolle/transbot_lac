          <ownedRequirements xsi:type="Requirements:Requirement" id="a0a63b33-3bbd-4f30-bac9-31a1ed167870"
              ReqIFLongName="Debe requerir la mínima modificación de las instalaciones existentes">
            <ownedRelations xsi:type="Requirements:InternalRelation" id="14d44027-b35d-4542-90dd-5e3f8bdd8414"
