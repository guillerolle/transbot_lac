          <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
              id="070ba93d-a813-4af0-8f83-116a83dce609" name="mitigate dynamic transitions">
            <ownedConstraints xsi:type="org.polarsys.capella.core.data.capellacore:Constraint"
                id="7c4f5928-b66a-4119-9e76-c86abc75ca23" name="preferable passive due low cost requirement"
                constrainedElements="#4264d8b1-02ab-4018-b935-ee783959bc5c">
              <ownedSpecification xsi:type="org.polarsys.capella.core.data.information.datavalue:OpaqueExpression"
                  id="dd2c1c75-33fa-41a4-ae0c-506817d305bb">
                <bodies></bodies>
