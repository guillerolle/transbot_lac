      <ownedInterfacePkg xsi:type="org.polarsys.capella.core.data.cs:InterfacePkg"
          id="9ba4f465-d149-4338-b23e-beaadc1d6976" name="Interfaces"/>
      <ownedDataPkg xsi:type="org.polarsys.capella.core.data.information:DataPkg"
          id="658792e5-8a30-4a67-a90c-72c8d9c40881" name="Data">
        <ownedDataPkgs xsi:type="org.polarsys.capella.core.data.information:DataPkg"
            id="9e28b196-94b3-45ef-9c25-e7c1b9b31e4c" name="EA - Materials Transport">
          <ownedClasses xsi:type="org.polarsys.capella.core.data.information:Class"
              id="f0c208ec-c5b8-471c-9339-1ddd0dceeee4" name="Material Handling" description="&lt;p>Evaluation of alternatives for Materials Transportation methods:&lt;/p>&#xA;&#xA;&lt;ul>&#xA;&#x9;&lt;li>&lt;b>Criteria of categorization:&amp;nbsp;&lt;/b>Type and size of unit interacting elements&#xA;&#xA;&#x9;&lt;ul>&#xA;&#x9;&lt;/ul>&#xA;&#x9;&lt;/li>&#xA;&lt;/ul>&#xA;&#xA;&lt;div>&amp;nbsp;&lt;/div>&#xA;"/>
          <ownedClasses xsi:type="org.polarsys.capella.core.data.information:Class"
              id="47b25bb2-c0b8-4771-8aa8-17a187683ede" name="Lifters" description="&lt;p>Forklifts use two forks&amp;nbsp;in front that can move up/down and enlarge/reduce its spacing to lift containerized objects.&lt;/p>&#xA;&#xA;&lt;p>Requirements:&lt;/p>&#xA;&#xA;&lt;ul>&#xA;&#x9;&lt;li>Safety concerns in regards forks at front of the vehicle&lt;/li>&#xA;&#x9;&lt;li>Counterweight / heavy chassis for compensating load weight far from support points.&lt;/li>&#xA;&lt;/ul>&#xA;&#xA;&lt;div>&amp;nbsp;&lt;/div>&#xA;">
            <ownedGeneralizations xsi:type="org.polarsys.capella.core.data.capellacore:Generalization"
                id="12ea4579-3697-40a7-9a34-13822c38b7bb" super="#672d065c-5c12-43bd-8ac1-525ed26de48c"
                sub="#47b25bb2-c0b8-4771-8aa8-17a187683ede"/>
          </ownedClasses>
          <ownedClasses xsi:type="org.polarsys.capella.core.data.information:Class"
              id="d55432de-6802-4e10-a0ef-40913c79a4d6" name="Robot Arms" description="&lt;p>Classis robot arms of any type. They work better at manipulating &lt;strong>precisely small items,&amp;nbsp;&lt;/strong>instead of moving large amounts without requiring full precision.&lt;/p>&#xA;&#xA;&lt;p>&amp;nbsp;&lt;/p>&#xA;">
            <ownedGeneralizations xsi:type="org.polarsys.capella.core.data.capellacore:Generalization"
                id="98d84193-a674-4732-b017-3254237aaf18" super="#61578281-be31-4cea-b79d-1bf925cfa921"
                sub="#d55432de-6802-4e10-a0ef-40913c79a4d6"/>
          </ownedClasses>
          <ownedClasses xsi:type="org.polarsys.capella.core.data.information:Class"
              id="dbfafc7e-1ff6-41dc-9843-2e885cdc607a" name="Full Lift" description="&lt;p>Push or pull entire shelves, moving large amounts of materials at once.&lt;/p>&#xA;&#xA;&lt;ul>&#xA;&#x9;&lt;li>System is not required to lift the transported weight, only to push/pull it.&lt;/li>&#xA;&#x9;&lt;li>Shelves could have wheels and suspension&amp;nbsp;to aid movement.&lt;/li>&#xA;&lt;/ul>&#xA;">
            <ownedGeneralizations xsi:type="org.polarsys.capella.core.data.capellacore:Generalization"
                id="321d20f9-c7a1-4958-b050-d2a80ef9407c" super="#dee1b3f5-701d-4679-a0c6-75ec63a6bd0b"
                sub="#dbfafc7e-1ff6-41dc-9843-2e885cdc607a"/>
          </ownedClasses>
          <ownedClasses xsi:type="org.polarsys.capella.core.data.information:Class"
              id="48623dc6-b609-4c8f-9f41-109d053ab8df" name="Sliders" description="&lt;p>Sliders shall&amp;nbsp;collect materials from the shelves by making them slide towards and out&amp;nbsp;the system instead of lifting.&amp;nbsp;&lt;/p>&#xA;&#xA;&lt;ul>&#xA;&#x9;&lt;li>Shelves could have rollers to aid the sliding motion, as well as the system&amp;#39;s supporting tables.&lt;/li>&#xA;&lt;/ul>&#xA;">
            <ownedGeneralizations xsi:type="org.polarsys.capella.core.data.capellacore:Generalization"
                id="f48d4e94-f669-4129-b445-47865c615bd4" super="#672d065c-5c12-43bd-8ac1-525ed26de48c"
                sub="#48623dc6-b609-4c8f-9f41-109d053ab8df"/>
          </ownedClasses>
          <ownedClasses xsi:type="org.polarsys.capella.core.data.information:Class"
              id="672d065c-5c12-43bd-8ac1-525ed26de48c" name="Structured Containers"
              description="&lt;p>Materials come in structured containers (&lt;b>boxes, baskets, etc.&lt;/b>) with many elements or parts.&lt;/p>&#xA;&#xA;&lt;p>The&amp;nbsp;containers are structured or rigid. It&amp;#39;s relatively easy to find grasp points in comparison to non-structured.&lt;/p>&#xA;">
            <ownedGeneralizations xsi:type="org.polarsys.capella.core.data.capellacore:Generalization"
                id="54bb976f-f181-4280-92d7-ffc724806dcc" super="#f0c208ec-c5b8-471c-9339-1ddd0dceeee4"
                sub="#672d065c-5c12-43bd-8ac1-525ed26de48c"/>
          </ownedClasses>
          <ownedClasses xsi:type="org.polarsys.capella.core.data.information:Class"
              id="307d7cc9-3d28-4571-b442-5fca96045256" name="Non-structured Containers"
              description="&lt;p>Non-uniform containers of many parts or components like &lt;strong>bags&amp;nbsp;&lt;/strong>(default type in the factory).&amp;nbsp;&lt;br />&#xA;Materials come in non-rigid or structurized containers with&amp;nbsp;many (100+) parts (like springs, knuts, bolts, etc)&lt;/p>&#xA;">
            <ownedGeneralizations xsi:type="org.polarsys.capella.core.data.capellacore:Generalization"
                id="4d22231b-8526-4c57-8595-98b3cc487b67" super="#f0c208ec-c5b8-471c-9339-1ddd0dceeee4"
                sub="#307d7cc9-3d28-4571-b442-5fca96045256"/>
          </ownedClasses>
          <ownedClasses xsi:type="org.polarsys.capella.core.data.information:Class"
              id="61578281-be31-4cea-b79d-1bf925cfa921" name="Individual Parts" summary=""
              description="&lt;p>Small and light parts and/or objects. May come organised or not, but the system shall grab one by one or small quantities&lt;/p>&#xA;">
            <ownedGeneralizations xsi:type="org.polarsys.capella.core.data.capellacore:Generalization"
                id="ff8935f3-7bf6-4ec8-9b36-f7b8b19e6032" super="#f0c208ec-c5b8-471c-9339-1ddd0dceeee4"
                sub="#61578281-be31-4cea-b79d-1bf925cfa921"/>
          </ownedClasses>
          <ownedClasses xsi:type="org.polarsys.capella.core.data.information:Class"
              id="dee1b3f5-701d-4679-a0c6-75ec63a6bd0b" name="Shelves Engagement"
              description="&lt;p>Instead of moving individuals/groups of materials from one shelve to another, the system shall move entire shelves, plenty of materials&lt;/p>&#xA;">
            <ownedGeneralizations xsi:type="org.polarsys.capella.core.data.capellacore:Generalization"
                id="0d8315e4-c819-4e85-bae8-d5e7560855b0" super="#f0c208ec-c5b8-471c-9339-1ddd0dceeee4"
                sub="#dee1b3f5-701d-4679-a0c6-75ec63a6bd0b"/>
          </ownedClasses>
          <ownedClasses xsi:type="org.polarsys.capella.core.data.information:Class"
              id="ae2d6c72-0866-4d41-8f42-f7023d5f8d91" name="Double Robot Arms">
            <ownedGeneralizations xsi:type="org.polarsys.capella.core.data.capellacore:Generalization"
                id="d7a37268-492a-4d50-928b-aeb6be9d6fd2" super="#307d7cc9-3d28-4571-b442-5fca96045256"
                sub="#ae2d6c72-0866-4d41-8f42-f7023d5f8d91"/>
          </ownedClasses>
          <ownedClasses xsi:type="org.polarsys.capella.core.data.information:Class"
              id="9e6e9e94-7672-4ff6-b7dd-261b75dadd52" name="Trailer" description="&lt;p>Push or pull entire shelves, moving large amounts of materials at once.&lt;/p>&#xA;&#xA;&lt;ul>&#xA;&#x9;&lt;li>System is not required to lift the transported weight, only to push/pull it.&lt;/li>&#xA;&#x9;&lt;li>Shelves could have wheels and suspension&amp;nbsp;to aid movement.&lt;/li>&#xA;&lt;/ul>&#xA;">
            <ownedGeneralizations xsi:type="org.polarsys.capella.core.data.capellacore:Generalization"
                id="0c509a24-23e5-45a3-bf80-c2756d46c690" super="#dee1b3f5-701d-4679-a0c6-75ec63a6bd0b"
                sub="#9e6e9e94-7672-4ff6-b7dd-261b75dadd52"/>
          </ownedClasses>
          <ownedClasses xsi:type="org.polarsys.capella.core.data.information:Class"
              id="30b52e10-de54-42c9-a0e8-d48b13186fca" name="Rigid Coupling" description="&lt;p>Push or pull entire shelves, moving large amounts of materials at once.&lt;/p>&#xA;&#xA;&lt;ul>&#xA;&#x9;&lt;li>System is not required to lift the transported weight, only to push/pull it.&lt;/li>&#xA;&#x9;&lt;li>Shelves could have wheels and suspension&amp;nbsp;to aid movement.&lt;/li>&#xA;&lt;/ul>&#xA;">
            <ownedGeneralizations xsi:type="org.polarsys.capella.core.data.capellacore:Generalization"
                id="71c2a6e3-269b-4a6d-add1-e43259f9ccd3" super="#dee1b3f5-701d-4679-a0c6-75ec63a6bd0b"
                sub="#30b52e10-de54-42c9-a0e8-d48b13186fca"/>
          </ownedClasses>
        </ownedDataPkgs>
        <ownedDataPkgs xsi:type="org.polarsys.capella.core.data.information:DataPkg"
            id="b5ee531d-a6da-481a-b037-bae077bc3645" name="EA - Suspension System">
