          <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
              id="002150b5-2795-4115-88e5-e6675e7a4808" name="secure materials during transport"
              description="&lt;p>The core idea is that the system shall safely transport materials from one place to another.&amp;nbsp;&lt;/p>&#xA;&#xA;&lt;p>However, it&amp;#39;s possible that only having a suspension system that mitigates vibrations and smoothens accelerations is enough for this use case, and no active sensoring or control is required.&lt;/p>&#xA;">
            <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                id="ebac351d-b90e-4e5f-8da9-2ed37ec275f1" name="FIP 1"/>
            <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                id="1d6c0df9-129c-4b4b-aef7-093cbe0310d2" name="FIP 2"/>
            <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
