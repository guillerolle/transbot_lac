          <ownedCapabilities xsi:type="org.polarsys.capella.core.data.ctx:Capability"
              id="bf9c44a3-ec04-4811-9c69-f809ef4c9116" name="CS03 - SHELF TRANSPORT"
              description="&lt;h1>CONSTRUCTION STAGE: SHELF TRANSPORT&lt;/h1>&#xA;&#xA;&lt;div>Incluye sistema de acople con estanter&amp;iacute;as. Comandado por joystick pero con sistema de asistencia de alineaci&amp;oacute;n y demases.&lt;/div>&#xA;&#xA;&lt;p>&lt;strong>Verificaci&amp;oacute;n:&lt;/strong>&lt;/p>&#xA;&#xA;&lt;ul>&#xA;&#x9;&lt;li>Electr&amp;oacute;nica:&#xA;&#x9;&lt;ul>&#xA;&#x9;&#x9;&lt;li>Alertas alineaci&amp;oacute;n sistema de acople&lt;/li>&#xA;&#x9;&#x9;&lt;li>etc.&lt;/li>&#xA;&#x9;&lt;/ul>&#xA;&#x9;&lt;/li>&#xA;&#x9;&lt;li>Mec&amp;aacute;nica:&#xA;&#x9;&lt;ul>&#xA;&#x9;&#x9;&lt;li>Interfaz de acople&lt;/li>&#xA;&#x9;&#x9;&lt;li>Mecanismo de acople&lt;/li>&#xA;&#x9;&lt;/ul>&#xA;&#x9;&lt;/li>&#xA;&lt;/ul>&#xA;&#xA;&lt;p>&lt;strong>Operaci&amp;oacute;n:&amp;nbsp;&lt;/strong>&lt;/p>&#xA;&#xA;&lt;ul>&#xA;&#x9;&lt;li>Manual por joystick.&lt;/li>&#xA;&#x9;&lt;li>Posicionamiento de sistema en posici&amp;oacute;n de acople -&amp;gt; acople autom&amp;aacute;tico bajo comando manual.&lt;/li>&#xA;&lt;/ul>&#xA;&#xA;&lt;div>&amp;nbsp;&lt;/div>&#xA;&#xA;&lt;div>&amp;nbsp;&lt;/div>&#xA;">
