			'pos_from_chassis': Matrix([[bi.e*sin(bi.w_{1s}.\beta(t)) + xs], [-bi.e*cos(bi.w_{1s}.\beta(t))], [0]]),
			'pos_from_global': Matrix([[bi.e*sin(bi.\theta(t) + bi.w_{1s}.\beta(t)) + xs*cos(bi.\theta(t)) + bi.x(t)], [-bi.e*cos(bi.\theta(t) + bi.w_{1s}.\beta(t)) + xs*sin(bi.\theta(t)) + bi.y(t)], [bi.h]]),
}
		'h': Matrix([[bi.e*sin(bi.\theta(t) + bi.w_{1s}.\beta(t)) + xs*cos(bi.\theta(t)) + bi.x(t)], [-bi.e*cos(bi.\theta(t) + bi.w_{1s}.\beta(t)) + xs*sin(bi.\theta(t)) + bi.y(t)]]),
		'dhdxi': Matrix([[1, 0, bi.e*cos(bi.\theta(t) + bi.w_{1s}.\beta(t)) - xs*sin(bi.\theta(t))], [0, 1, bi.e*sin(bi.\theta(t) + bi.w_{1s}.\beta(t)) + xs*cos(bi.\theta(t))]]),
		'dhdbetas': Matrix([[bi.e*cos(bi.\theta(t) + bi.w_{1s}.\beta(t))], [bi.e*sin(bi.\theta(t) + bi.w_{1s}.\beta(t))]]),
		'dhdt': Matrix([[bi.e*(bi.\omega(t) + bi.w_{1s}.\betad(t))*cos(bi.\theta(t) + bi.w_{1s}.\beta(t)) - xs*bi.\omega(t)*sin(bi.\theta(t)) + bi.vx(t)], [bi.e*(bi.\omega(t) + bi.w_{1s}.\betad(t))*sin(bi.\theta(t) + bi.w_{1s}.\beta(t)) + xs*bi.\omega(t)*cos(bi.\theta(t)) + bi.vy(t)]]),
		'K': Matrix([[xf*sin(bi.\theta(t))*cos(bi.w_{1s}.\beta(t)) + (xf - xs)*sin(bi.w_{1s}.\beta(t))*cos(bi.\theta(t)) + (bi.e*cos(bi.\theta(t) + bi.w_{1s}.\beta(t)) - xs*sin(bi.\theta(t)))*cos(bi.w_{1s}.\beta(t)), bi.e*cos(bi.\theta(t) + bi.w_{1s}.\beta(t))], [-xf*cos(bi.\theta(t))*cos(bi.w_{1s}.\beta(t)) + (xf - xs)*sin(bi.\theta(t))*sin(bi.w_{1s}.\beta(t)) + (bi.e*sin(bi.\theta(t) + bi.w_{1s}.\beta(t)) + xs*cos(bi.\theta(t)))*cos(bi.w_{1s}.\beta(t)), bi.e*sin(bi.\theta(t) + bi.w_{1s}.\beta(t))]]),
		'K^-1': Matrix([[sin(bi.\theta(t) + bi.w_{1s}.\beta(t))/(xf - xs), -cos(bi.\theta(t) + bi.w_{1s}.\beta(t))/(xf - xs)], [(-bi.e*sin(bi.\theta(t) + bi.w_{1s}.\beta(t))*cos(bi.w_{1s}.\beta(t)) + xf*cos(bi.\theta(t) + bi.w_{1s}.\beta(t)) - xs*cos(bi.\theta(t) + bi.w_{1s}.\beta(t)))/(bi.e*(xf - xs)), (bi.e*cos(bi.\theta(t) + bi.w_{1s}.\beta(t))*cos(bi.w_{1s}.\beta(t)) + xf*sin(bi.\theta(t) + bi.w_{1s}.\beta(t)) - xs*sin(bi.\theta(t) + bi.w_{1s}.\beta(t)))/(bi.e*(xf - xs))]]),
}
}
}

